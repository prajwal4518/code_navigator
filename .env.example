# Codebase Navigator - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Provider: gemini, ollama, anthropic, openai
LLM_PROVIDER=gemini

# Model name (optional - uses provider defaults if not set)
# LLM_MODEL=gemini-2.0-flash

# =============================================================================
# API Keys (set the one for your chosen provider)
# =============================================================================
# Google Gemini - https://aistudio.google.com/apikey
GOOGLE_API_KEY=<your_api_key>

# Anthropic Claude - https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# OpenAI - https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Ollama (local) - no API key needed
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Vector Store Configuration
# =============================================================================
# Directory where ChromaDB persists vector data
CHROMA_PERSIST_DIR=./data/chroma

# Collection name for code embeddings
CHROMA_COLLECTION_NAME=code_navigator

# =============================================================================
# Embedding Model Configuration
# =============================================================================
# Local model (default) - no API key required
# Options: all-MiniLM-L6-v2, all-mpnet-base-v2, code-search-net
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Use local embeddings (true) or API embeddings (false)
USE_LOCAL_EMBEDDINGS=true

# =============================================================================
# LLM Configuration
# =============================================================================
# Gemini model for code understanding
LLM_MODEL=gemini-1.5-flash

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.1

# =============================================================================
# Logging & Observability
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# MLflow tracking URI (local or remote)
MLFLOW_TRACKING_URI=./data/mlruns

# =============================================================================
# API Server Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Development Settings
# =============================================================================
# Enable debug mode (additional logging, hot reload)
DEBUG=true
